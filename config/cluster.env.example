# Copy this file to config/cluster.env, edit it for your cluster, then run:
#   source config/cluster.env

export SBATCH_PARTITION="amd_512q"
export SBATCH_NODES="1"
export SBATCH_NTASKS="32"
export WORK_DIR="/path/to/dft-workflow"
export ORCA_BIN="/path/to/orca/orca"
export MODULE_INIT="/path/to/modules/module.sh"
export ORCA_MODULE="orca/6_0_1_linux_x86-64_shared_openmpi416_avx2"
